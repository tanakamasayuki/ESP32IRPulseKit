# Profile-specific serial ports.
TEST_SERIAL_PORT_HOST=socket://localhost

TEST_SERIAL_PORT_RX_ESP32S3=/dev/ttyUSB0
TEST_SERIAL_PORT_PEER_TX_TX_ESP32S3=/dev/ttyUSB1
# ESP32 classic board for pc/codec_smoke (may be the same board as TEST_SERIAL_PORT_RX_ESP32).
TEST_SERIAL_PORT_ESP32=/dev/ttyUSB3

# ESP32 classic pair (the release check runs every RX/TX pair: --profiles all --peer-profiles all).
TEST_SERIAL_PORT_RX_ESP32=/dev/ttyUSB3
TEST_SERIAL_PORT_PEER_TX_TX_ESP32=/dev/ttyUSB4

# IR hardware pins used by hardware/tx_rx.
TEST_IR_TX_GPIO=4
TEST_IR_TX_INVERTED=0
TEST_IR_RX_GPIO=32
TEST_IR_RX_INVERTED=1

# Single-board wired loopback pins for studies/tx_jitter_loopback
# (TX GPIO jumpered directly to RX GPIO on the one board).
TEST_LOOPBACK_TX_GPIO=5
TEST_LOOPBACK_RX_GPIO=6

# Optional HTML report:
# PYTEST_ADDOPTS="--html=report.html --self-contained-html"
